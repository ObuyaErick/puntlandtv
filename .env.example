# Copy to .env before `docker compose up`. Every value here is read at BUILD
# time, so re-run with --build after changing one.
#
#   cp .env.example .env

# The backend both apps talk to. Leave it empty to run entirely on the bundled
# fixtures, which is the no-backend demo mode.
API_BASE_URL=https://puntland-api.tenslet.com/api

# Force fixtures even when API_BASE_URL is set.
USE_FIXTURES=false

# Published ports on the host.
APP_PORT=3002
CONSOLE_PORT=3003

# Image tag, e.g. TAG=v1.0.0
TAG=latest
